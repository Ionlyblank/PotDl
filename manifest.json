{
  "manifest_version": 3,
  "name": "PotDl",
  "version": "1.0.0",
  "description": "Open video links in PotPlayer with the right subtitles already loaded, in any language SubDL offers.",
  "key": "",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "downloads", "downloads.ui", "nativeMessaging"],
  "host_permissions": ["https://api.subdl.com/*", "https://dl.subdl.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PotDl",
    "default_popup": "subtitles.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
